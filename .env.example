# Copy to .env and fill in. Never commit .env
#
# LOCAL RULE: point at DEV resources only (dev DB + dev R2).
# Production credentials belong in Render dashboard env vars, not on your laptop.
#
# See: docs/superpowers/specs/2026-08-08-environments-design.md

# --- Cloudflare (DNS + R2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- Local / Dev R2 (NOT prod bucket) ---
R2__BucketName=kairospayhub-assets-dev
R2__PublicBaseUrl=https://pub-<dev-bucket-id>.r2.dev

# --- Prod R2 (Render prod API only — do not use locally) ---
# R2__BucketName=kairospayhub-assets
# R2__PublicBaseUrl=https://pub-<prod-bucket-id>.r2.dev

# --- Render ---
RENDER_API_KEY=

# Dev Postgres external URL (Render dashboard → kairospayhub-db-dev → External)
ConnectionStrings__Default=postgresql://USER:PASSWORD@HOST/kairospayhub_dev

# --- API (local) ---
# ASP.NET Core env var format (double underscore):
Jwt__SigningKey=local-dev-signing-key-min-32-chars!!
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__Username=resend
Email__Smtp__Password=
Email__Smtp__UseTls=true
Email__FromAddress=noreply@kairospayhub.com
Email__FromName=KairosPayHub
Email__FrontendBaseUrl=http://127.0.0.1:5173

# --- Frontend (local Vite) ---
# VITE_API_URL=http://localhost:5192
