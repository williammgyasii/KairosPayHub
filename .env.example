# Copy to .env and fill in. Never commit .env

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2__BucketName=kairospayhub-assets
R2__PublicBaseUrl=https://pub-4b6f9094899b4817981a886d2f8a9dd6.r2.dev

# --- Render ---
RENDER_API_KEY=
# External Postgres URL (local dev uses cloud DB — same as TablePlus)
ConnectionStrings__Default=postgresql://USER:PASSWORD@HOST/DATABASE

# --- API (local + Render dashboard) ---
JWT_SIGNING_KEY=
# Resend SMTP — https://resend.com/docs/send-with-smtp
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__Username=resend
Email__Smtp__Password=
Email__Smtp__UseTls=true
Email__FromAddress=noreply@kairospayhub.com
Email__FromName=KairosPayHub
Email__FrontendBaseUrl=http://127.0.0.1:5173
