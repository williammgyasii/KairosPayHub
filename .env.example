# Copy to .env and fill in. Never commit .env
#
# LOCAL RULE: point at DEV resources only (dev DB + dev R2).
# Production credentials belong in Cloudflare Worker secrets / GitHub Actions, not on your laptop.
#
# See: docs/superpowers/specs/2026-08-08-environments-design.md
# Runbook: infra/environments.md

# --- Cloudflare (DNS + R2 + deploy) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
# Prefer API token for wrangler CI (Workers + Pages edit)
# CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- Local / Dev R2 (NOT prod bucket) ---
R2__BucketName=kairospayhub-assets-dev
R2__PublicBaseUrl=https://pub-<dev-bucket-id>.r2.dev

# --- Prod R2 (Cloudflare prod Worker secrets only — do not use locally) ---
# R2_PROD_PUBLIC_BASE_URL=https://pub-<prod-bucket-id>.r2.dev

# --- Neon Postgres ---
# Dev (local + deployed dev API) — project kairospayhub-dev, database kairospayhub_dev
NEON_DEV_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/kairospayhub_dev?sslmode=require
ConnectionStrings__Default=postgresql://USER:PASSWORD@HOST/kairospayhub_dev?sslmode=require
# Prod (provision script only — do not use locally)
# NEON_PROD_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/kairospayhub?sslmode=require

# Prod (provision script only — do not use locally)
# NEON_PROD_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST/kairospayhub?sslmode=require
# JWT_PROD_SIGNING_KEY=your-prod-jwt-signing-key-min-32-chars!!

# --- API (local + Worker dev secrets) ---
Jwt__SigningKey=local-dev-signing-key-min-32-chars!!
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__Username=resend
Email__Smtp__Password=
Email__Smtp__UseTls=true
Email__FromAddress=noreply@kairospayhub.com
Email__FromName=KairosPayHub
Email__FrontendBaseUrl=http://127.0.0.1:5173

# --- Frontend (local Vite) ---
# VITE_API_URL=http://localhost:5192
