{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairospayhub-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "account_id": "e23518956f08ff35812d9ab001a39880",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  },
  "env": {
    "development": {
      "name": "kairospayhub-api-dev",
      "ratelimits": [
        {
          "name": "RATE_LIMIT_AUTH",
          "namespace_id": "3101",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_JOIN",
          "namespace_id": "3102",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_API",
          "namespace_id": "3103",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_HUBS",
          "namespace_id": "3104",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "dev.app.kairospayhub.com/*",
          "zone_name": "kairospayhub.com"
        }
      ],
      "workers_dev": true,
      "secrets": {
        "required": [
          "DB_CONNECTION_STRING",
          "JWT_SIGNING_KEY",
          "EMAIL_SMTP_HOST",
          "EMAIL_SMTP_USERNAME",
          "EMAIL_SMTP_PASSWORD",
          "EMAIL_FROM_ADDRESS",
          "R2_PUBLIC_BASE_URL",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "R2_ENDPOINT",
          "WEB_PUSH_PUBLIC_KEY",
          "WEB_PUSH_PRIVATE_KEY",
          "WEB_PUSH_SUBJECT"
        ]
      },
      "containers": [
        {
          "class_name": "KairosApiContainer",
          "image": "../../kairospayhub-api/Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "API",
            "class_name": "KairosApiContainer"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["KairosApiContainer"]
        }
      ],
      "vars": {
        "PAGES_ORIGIN": "https://kairospayhub-frontend-dev.pages.dev",
        "JWT_ISSUER": "https://dev.app.kairospayhub.com",
        "JWT_AUDIENCE": "kairospayhub-dev",
        "EMAIL_FRONTEND_BASE_URL": "https://dev.app.kairospayhub.com",
        "EMAIL_FROM_NAME": "KairosPayHub (Dev)",
        "EMAIL_SMTP_PORT": "587",
        "EMAIL_SMTP_USE_TLS": "true",
        "R2_BUCKET_NAME": "kairospayhub-assets-dev",
        "CORS_ORIGIN_PRIMARY": "https://dev.app.kairospayhub.com",
        "CORS_ORIGIN_SECONDARY": "http://127.0.0.1:5173",
        "TURNSTILE_ALLOWED_HOSTNAMES": "dev.app.kairospayhub.com,127.0.0.1,localhost",
        "FEATURE_FLAG_SERVICE_RECORDINGS_ENABLED": "true",
        "FEATURE_FLAG_SERVICE_RECORDINGS_ALLOWED_CHURCH_IDS": "",
        "BUNNY_STREAM_LIBRARY_ID": "752627"
      }
    },
    "production": {
      "name": "kairospayhub-api",
      "ratelimits": [
        {
          "name": "RATE_LIMIT_AUTH",
          "namespace_id": "3001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_JOIN",
          "namespace_id": "3002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_API",
          "namespace_id": "3003",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RATE_LIMIT_HUBS",
          "namespace_id": "3004",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "app.kairospayhub.com/*",
          "zone_name": "kairospayhub.com"
        }
      ],
      "workers_dev": true,
      "secrets": {
        "required": [
          "DB_CONNECTION_STRING",
          "JWT_SIGNING_KEY",
          "EMAIL_SMTP_HOST",
          "EMAIL_SMTP_USERNAME",
          "EMAIL_SMTP_PASSWORD",
          "EMAIL_FROM_ADDRESS",
          "R2_PUBLIC_BASE_URL",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "R2_ENDPOINT",
          "WEB_PUSH_PUBLIC_KEY",
          "WEB_PUSH_PRIVATE_KEY",
          "WEB_PUSH_SUBJECT"
        ]
      },
      "containers": [
        {
          "class_name": "KairosApiContainer",
          "image": "../../kairospayhub-api/Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "API",
            "class_name": "KairosApiContainer"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["KairosApiContainer"]
        }
      ],
      "vars": {
        "PAGES_ORIGIN": "https://kairospayhub-frontend.pages.dev",
        "JWT_ISSUER": "https://app.kairospayhub.com",
        "JWT_AUDIENCE": "kairospayhub",
        "EMAIL_FRONTEND_BASE_URL": "https://app.kairospayhub.com",
        "EMAIL_FROM_NAME": "KairosPayHub",
        "EMAIL_SMTP_PORT": "587",
        "EMAIL_SMTP_USE_TLS": "true",
        "R2_BUCKET_NAME": "kairospayhub-assets",
        "CORS_ORIGIN_PRIMARY": "https://app.kairospayhub.com",
        "CORS_ORIGIN_SECONDARY": "http://127.0.0.1:5173",
        "TURNSTILE_ALLOWED_HOSTNAMES": "app.kairospayhub.com",
        "FEATURE_FLAG_SERVICE_RECORDINGS_ENABLED": "false",
        "FEATURE_FLAG_SERVICE_RECORDINGS_ALLOWED_CHURCH_IDS": ""
      }
    }
  }
}
