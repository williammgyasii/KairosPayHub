# Copy to .dev.vars for local `wrangler dev` (never commit .dev.vars)
DB_CONNECTION_STRING=postgresql://user:pass@host/db?sslmode=require
JWT_SIGNING_KEY=local-dev-signing-key-min-32-chars!!
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@kairospayhub.com
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://account.r2.cloudflarestorage.com
